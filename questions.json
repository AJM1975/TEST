# Build 500 extras, preserving order and uniqueness.
candidate_extras = []
candidate_extras.extend(quirky)
candidate_extras.extend(reflective)
candidate_extras.extend(leadership)
candidate_extras.extend(story)
candidate_extras.extend(debate)
candidate_extras.extend(funny_prompts)

seen = set(existing_questions)
extras = []
for q in candidate_extras:
    if q not in seen:
        extras.append(q)
        seen.add(q)
    if len(extras) == 500:
        break

all_questions = existing_questions + extras

assert len(extras) == 500, len(extras)
assert len(all_questions) == len(set(all_questions))

out = Path("/mnt/data/questions-560.json")
out.write_text(json.dumps(all_questions, ensure_ascii=False, indent=2), encoding="utf-8")

print(f"Created {out} with {len(all_questions)} questions ({len(existing_questions)} existing + {len(extras)} new).")
